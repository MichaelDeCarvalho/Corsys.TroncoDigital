{
  "name": "corsys-tronco-digital",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "vite --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host=0.0.0.0",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:dev": "npm run build && wrangler deploy --config wrangler.dev.jsonc",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "lucide-react": "0.546.0",
    "react": "19.0.1",
    "react-dom": "19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.14",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.14.0",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "27.0.0",
    "tailwindcss": "4.1.14",
    "typescript": "5.8.2",
    "vite": "6.4.3",
    "vitest": "5.0.2",
    "wrangler": "4.151.0"
  }
}
