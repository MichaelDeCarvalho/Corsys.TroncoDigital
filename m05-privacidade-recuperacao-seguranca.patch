+  pending_triage: 'Em triagem (meta 2 dias úteis)',
+  fulfilled: 'Atendida',
+  pseudonymized: 'Pseudonimizada (reidentificável — proteção mantida)',
+  anonymized_verified: 'Anonimizada (sem risco residual)',
