+  organization_id: string | null
+  severity: 'low' | 'medium' | 'high' | 'critical'
+  category: 'availability' | 'auth_authz' | 'job_failure' | 'backup_restore' | 'privacy_security'
+  status: 'open' | 'investigating' | 'mitigated' | 'closed'
+  title: string
