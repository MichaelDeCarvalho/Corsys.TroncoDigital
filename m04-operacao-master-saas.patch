+     }
+    }
+    newEntitlementsRef.current.value=JSON.stringify(current,null,2)
+   }
+  }catch{
+   // leave user JSON untouched if malformed
+  }
+ }
 
  useEffect(()=>{mounted.current=true;return()=>{mounted.current=false}},[])
 
