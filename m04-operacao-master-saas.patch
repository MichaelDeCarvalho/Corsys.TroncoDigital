+    p_organization_id,
+    'register_saas_fiscal_document_idempotent',
+    v_key,
+    jsonb_build_object(
+      'invoice_id', p_invoice_id,
+      'document_type', p_document_type,
+      'status', p_status,
+      'document_number', v_doc_num,
+      'external_reference', v_ext_ref
+    )
+  );
+  if v_existing is not null then
+    return v_existing;
+  end if;
