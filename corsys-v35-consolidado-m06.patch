+                          <td>{formatCompetence(row.accounting_period)}</td>
+                          <td>
+                            {DIARY_EVENT_LABELS[row.event_type] ?? row.event_type}
+                            {row.is_reversal_or_correction && (
+                              <span className="pill warning" style={{ marginLeft: '0.35rem' }}>Estorno/Retificação</span>
+                            )}
+                          </td>
