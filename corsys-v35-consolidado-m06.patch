+  insert into public.audit_logs (
+    organization_id, actor_user_id, action, entity_type, entity_id, after_data, reason
+  ) values (
+    p_organization_id,
+    v_user,
+    'privacy.portability_export_created',
+    'tenant_portability_exports',
+    v_export_id,
