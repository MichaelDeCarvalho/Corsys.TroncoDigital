+                {!plans.length && <option value="">Nenhum plano cadastrado</option>}
+                {plans.map(p => (
+                  <option key={p.id} value={p.id}>
+                    {p.name} — {p.status === 'published' ? 'Publicado' : 'Rascunho'} ({p.valid_from.slice(0, 7)} a {p.valid_to.slice(0, 7)})
