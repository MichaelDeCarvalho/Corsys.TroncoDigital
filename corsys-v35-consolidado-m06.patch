+  end if;
+
+  select p.id, v.id into v_plan_id, v_plan_ver_id
+  from public.saas_plans p
+  join public.saas_plan_versions v on v.plan_id = p.id
+  where p.price = 0 and v.price = 0
+  order by v.created_at asc
