+    'payload_sha256', v_sha256,
+    'expires_at', v_expires_at,
+    'manifest', v_manifest,
+    'data_dictionary', v_dictionary
+  );
+
+  perform private.m05_idempotency_complete(p_organization_id::text, p_idempotency_key, v_result);
+  return v_result;
