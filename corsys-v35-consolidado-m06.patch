diff --git a/scripts/v35_m05_backup_manifest.py b/scripts/v35_m05_backup_manifest.py
new file mode 100644
index 0000000..e43d784
--- /dev/null
+++ b/scripts/v35_m05_backup_manifest.py
@@ -0,0 +1,117 @@
+"""D04 Backup & Recovery Sanitized Inventory Manifest Generator.
+
+Generates an auditable, secret-free manifest covering database migrations,
+private storage buckets, configuration key names (no secret values),
+35-day max rotation policy, and RPO/RTO readiness targets marked unproven
+until disposable restore telemetry passes.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+FORBIDDEN_VALUE_RE = re.compile(r"(sb_secret_|eyJ[a-zA-Z0-9_-]+\.|password=|POSTGRES_PASSWORD=[^\n]+)", re.I)
+
+
+def parse_env_example_keys(env_path: Path) -> list[str]:
+    if not env_path.is_file():
+        return []
+    keys: list[str] = []
+    for raw in env_path.read_text(encoding="utf-8").splitlines():
+        line = raw.strip()
+        if not line or line.startswith("#") or "=" not in line:
+            continue
+        key = line.split("=", 1)[0].strip()
+        if key:
+            keys.append(key)
+    return sorted(set(keys))
+
+
+def build_backup_manifest(root: Path = ROOT) -> dict:
+    migrations = sorted((root / "supabase/migrations").glob("*.sql"))
+    env_keys = parse_env_example_keys(root / ".env.example")
+    wrangler_dev = root / "wrangler.dev.jsonc"
+
+    config_files = []
+    for rel in (".env.example", "wrangler.dev.jsonc", "package.json", "package-lock.json"):
+        p = root / rel
+        if p.is_file():
+            config_files.append({
+                "path": rel,
+                "sha256": hashlib.sha256(p.read_bytes()).hexdigest(),
+                "bytes": p.stat().st_size,
+            })
+
+    manifest = {
+        "schema_version": "2026.11-m05-d04",
+        "policy": {
+            "encrypted_off_primary_required": True,
+            "max_rotation_days": 35,
+            "rpo_target_hours": 24,
+            "rto_target_hours": 8,
+            "target_status": "target_unproven",
+            "disposable_trial_only_for_dev_qa": True,
+            "real_data_restore_authorized": False,
+        },
+        "components": {
+            "database": {
+                "engine": "PostgreSQL 17 / Supabase",
+                "migrations_count": len(migrations),
+                "latest_migration": migrations[-1].name if migrations else None,
+            },
+            "private_storage_buckets": [
+                {
+                    "bucket": "tenant-documents",
+                    "access": "private",
+                    "metadata_table": "public.documents",
+                    "verification_method": "checksum_and_inventory_only",
+                },
+                {
+                    "bucket": "org-assets",
+                    "access": "private",
+                    "metadata_table": "public.organization_settings.logo_path",
+                    "verification_method": "checksum_and_inventory_only",
+                },
+            ],
+            "configuration_checklist": {
+                "env_variable_names_only": env_keys,
+                "wrangler_dev_present": wrangler_dev.is_file(),
+                "tracked_config_hashes": config_files,
+                "secrets_stored_in_manifest": False,
+            },
+        },
+        "selective_recovery_guard": {
+            "single_tenant_isolation_required": True,
+            "deleted_or_pseudonymized_reintroduction_blocked": True,
+        },
+    }
+
+    serialized = json.dumps(manifest, sort_keys=True)
+    if FORBIDDEN_VALUE_RE.search(serialized):
+        raise ValueError("Sanitization failure: secret pattern detected in backup manifest")
+    manifest["manifest_sha256"] = hashlib.sha256(serialized.encode("utf-8")).hexdigest()
+    return manifest
+
+
+def self_test() -> None:
+    manifest = build_backup_manifest()
+    assert manifest["policy"]["max_rotation_days"] <= 35
+    assert manifest["policy"]["rpo_target_hours"] == 24
+    assert manifest["policy"]["rto_target_hours"] == 8
+    assert manifest["policy"]["target_status"] == "target_unproven"
+    assert manifest["policy"]["real_data_restore_authorized"] is False
+    assert manifest["components"]["configuration_checklist"]["secrets_stored_in_manifest"] is False
+    assert manifest["components"]["database"]["migrations_count"] >= 40
+    assert len(manifest["manifest_sha256"]) == 64
+    print("BACKUP_MANIFEST_SELF_TEST_PASS:", manifest["manifest_sha256"])
+
+
+if __name__ == "__main__":
+    if "--self-test" in sys.argv:
+        self_test()
+    else:
+        print(json.dumps(build_backup_manifest(), indent=2, ensure_ascii=False))
diff --git a/scripts/v35_m05_single_tenant_recovery_check.sql b/scripts/v35_m05_single_tenant_recovery_check.sql
new file mode 100644
index 0000000..62dffcf
--- /dev/null
+++ b/scripts/v35_m05_single_tenant_recovery_check.sql
@@ -0,0 +1,107 @@
+-- ==============================================================================
+-- CorSys Tronco Digital V35 — M05.02 (D04): Selective Single-Tenant Recovery Check
+-- Disposable PostgreSQL 17 Only. Never run against DEV or PROD.
+-- Demonstrates selective recovery of Loja A without overwriting Loja B and blocks
+-- reintroduction of deleted/pseudonymized contact data after T0.
+-- ==============================================================================
+
+DO $$
+DECLARE
+  v_db text := current_database();
+  v_org_a uuid := '00000000-0000-4000-8000-000000000001';
+  v_org_b uuid := '00000000-0000-4000-8000-000000000002';
+  v_b_count_before integer;
+  v_b_cents_before bigint;
+  v_b_count_after integer;
+  v_b_cents_after bigint;
+  v_a_recovered integer;
+  v_reintroduced integer;
+BEGIN
+  IF v_db !~ '(_gate|_test|_trial)$' THEN
+    RAISE EXCEPTION 'SAFETY ABORT: selective recovery check only allowed on disposable DB (_gate/_test/_trial), got %', v_db;
+  END IF;
+
+  SELECT count(*), coalesce(sum(round(original_amount * 100)::bigint), 0)
+  INTO v_b_count_before, v_b_cents_before
+  FROM public.charges
+  WHERE organization_id = v_org_b;
+
+  CREATE TEMP TABLE tmp_backup_snapshot_charges (
+    id uuid,
+    organization_id uuid,
+    member_id uuid,
+    original_amount numeric(14,2)
+  ) ON COMMIT DROP;
+
+  CREATE TEMP TABLE tmp_backup_snapshot_members (
+    id uuid,
+    organization_id uuid,
+    full_name text,
+    email text,
+    status text
+  ) ON COMMIT DROP;
+
+  CREATE TEMP TABLE tmp_privacy_tombstones (
+    organization_id uuid,
+    member_id uuid,
+    decision_outcome text
+  ) ON COMMIT DROP;
+
+  INSERT INTO tmp_backup_snapshot_charges
+  SELECT id, organization_id, member_id, original_amount
+  FROM public.charges
+  WHERE organization_id IN (v_org_a, v_org_b);
+
+  INSERT INTO tmp_backup_snapshot_members
+  SELECT id, organization_id, full_name, email, status
+  FROM public.members
+  WHERE organization_id IN (v_org_a, v_org_b);
+
+  INSERT INTO tmp_privacy_tombstones
+  SELECT r.organization_id, r.member_id, r.decision_outcome
+  FROM public.tenant_privacy_requests r
+  WHERE r.organization_id = v_org_a
+    AND r.member_id IS NOT NULL
+    AND r.decision_outcome IN ('pseudonymized', 'anonymized_verified');
+
+  CREATE TEMP TABLE tmp_selective_restore_loja_a AS
+  SELECT
+    s.id,
+    s.organization_id,
+    s.full_name,
+    CASE WHEN t.member_id IS NOT NULL THEN NULL ELSE s.email END AS safe_email,
+    CASE WHEN t.member_id IS NOT NULL THEN 'disconnected' ELSE s.status END AS safe_status
+  FROM tmp_backup_snapshot_members s
+  LEFT JOIN tmp_privacy_tombstones t
+    ON t.organization_id = s.organization_id
+   AND t.member_id = s.id
+  WHERE s.organization_id = v_org_a;
+
+  SELECT count(*) INTO v_a_recovered FROM tmp_selective_restore_loja_a;
+  IF v_a_recovered < 1 THEN
+    RAISE EXCEPTION 'SELECTIVE RECOVERY FAILED: expected Loja A rows in isolated restore stage';
+  END IF;
+
+  SELECT count(*) INTO v_reintroduced
+  FROM tmp_selective_restore_loja_a s
+  JOIN tmp_privacy_tombstones t
+    ON t.organization_id = s.organization_id
+   AND t.member_id = s.id
+  WHERE s.safe_email IS NOT NULL;
+
+  IF v_reintroduced <> 0 THEN
+    RAISE EXCEPTION 'ANTI-REINTRODUCTION FAILED: % pseudonymized members still exposed email', v_reintroduced;
+  END IF;
+
+  SELECT count(*), coalesce(sum(round(original_amount * 100)::bigint), 0)
+  INTO v_b_count_after, v_b_cents_after
+  FROM public.charges
+  WHERE organization_id = v_org_b;
+
+  IF v_b_count_before <> v_b_count_after OR v_b_cents_before <> v_b_cents_after THEN
+    RAISE EXCEPTION 'ISOLATION FAILED: Loja B altered during selective recovery of Loja A';
+  END IF;
+
+  RAISE NOTICE 'SELECTIVE_TENANT_RECOVERY_PASS: org_a_rows=%, org_b_untouched_charges=% (% cents), tombstones_respected=true',
+    v_a_recovered, v_b_count_after, v_b_cents_after;
+END $$;
