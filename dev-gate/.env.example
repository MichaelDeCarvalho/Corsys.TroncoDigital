# DEV ONLY. Nunca commitar valores reais.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

TEST_ADMIN_A_EMAIL=admin-a@example.invalid
TEST_ADMIN_A_PASSWORD=<strong-dev-password>
TEST_ADMIN_B_EMAIL=admin-b@example.invalid
TEST_ADMIN_B_PASSWORD=<strong-dev-password>

# Explicit guard; fill only for the selected disposable DEV project.
SUPABASE_DEV_PROJECT_REF=<selected-dev-project-ref>
CORSYS_DEV_FIXTURE_ACK=DEV_ONLY


# Dedicated DEV Master created by owner; never commit password.
TEST_MASTER_USER_ID=
TEST_MASTER_PASSWORD=

# Dedicated temporary SUPPORT/BILLING fixture, separate from Master and tenants.
TEST_STAFF_USER_ID=
TEST_STAFF_PASSWORD=
